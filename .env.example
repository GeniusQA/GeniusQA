# Docker Compose 环境变量配置示例
# 复制此文件为 .env 并修改相应的值

# MySQL 配置
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=ntester
MYSQL_USER=admin
MYSQL_PASSWORD=admin123456

# 应用配置
APP_ENV=production
APP_DEBUG=false

# GitHub Copilot MCP Server (n-tester/mcp.json)
# 将你的 GitHub Copilot token 填入环境变量，mcp.json 通过 ${GITHUB_COPILOT_TOKEN} 引用
# GITHUB_COPILOT_TOKEN=ghp_your_token_here
