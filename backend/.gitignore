#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover

# Translations
*.mo
*.pot

# Django stuff:
*.log
*.html
*.pyc
*.xml
*.iml


# Sphinx documentation
docs/_build/

# PyBuilder
target/

.venv
.claude

# Runtime
logs/
uploads/
# 浏览器临时目录（SYSTEM 身份下重定向到后端目录，避免 C:\WINDOWS\TEMP 锁冲突）
.pw_tmp/
